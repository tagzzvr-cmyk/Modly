<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Modly - Yeeps Moderator Searcher</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  background: #073e36;
  color: #fff5e9;
}

header {
  text-align: center;
  padding: 65px 20px 30px;
}

.logo {
  font-size: 85px;
  font-weight: 900;
  color: #ffb5aa;
  text-shadow: 4px 5px #784a45;
  letter-spacing: 5px;
}

.subtitle {
  font-size: 19px;
  color: #fff0d9;
}

.description {
  max-width: 550px;
  margin: 20px auto;
  line-height: 1.7;
}

.search-box {
  max-width: 650px;
  margin: 35px auto;
  padding: 0 20px;
}

input {
  width: 100%;
  padding: 18px 25px;
  border: 2px solid #ffb5aa;
  border-radius: 40px;
  font-size: 16px;
  outline: none;
  background: #fff8ed;
  color: #174d42;
}

.results {
  max-width: 750px;
  margin: auto;
  padding: 0 20px 50px;
}

.card {
  background: #15574c;
  border: 1px solid #478575;
  border-radius: 15px;
  padding: 20px;
  margin-bottom: 15px;
}

.card h3 {
  color: #ffb5aa;
  margin-top: 0;
}

.flower {
  position: fixed;
  font-size: 55px;
  color: #ffb5aa;
  opacity: .25;
  z-index: -1;
}

.flower.one { top: 15px; left: 20px; }
.flower.two { top: 150px; right: 20px; }
.flower.three { bottom: 30px; left: 30px; }
.flower.four { bottom: 100px; right: 30px; }

footer {
  text-align: center;
  padding: 25px;
  color: #d6e6dc;
}
</style>
</head>

<body>

<div class="flower one">✿</div>
<div class="flower two">❀</div>
<div class="flower three">✿</div>
<div class="flower four">❀</div>

<header>
  <div class="logo">Modly</div>
  <p class="subtitle">🌸 Yeeps Moderator Searcher 🌸</p>

  <p class="description">
    A tool designed to help Yeeps moderators quickly find
    relevant information and keep moderation organized.
  </p>
</header>

<div class="search-box">
  <input
    id="search"
    type="text"
    placeholder="Search moderators by name or role..."
  >
</div>

<main class="results" id="results"></main>

<footer>
  Modly · Yeeps Moderator Searcher
</footer>

<script>
const moderators = [
  {name: "ExampleMod1", role: "Senior Moderator"},
  {name: "ExampleMod2", role: "Moderator"},
  {name: "ExampleMod3", role: "Junior Moderator"},
  {name: "ExampleMod4", role: "Support"}
];

const search = document.getElementById("search");
const results = document.getElementById("results");

function displayModerators(query = "") {
  results.innerHTML = "";

  const filtered = moderators.filter(mod =>
    mod.name.toLowerCase().includes(query.toLowerCase()) ||
    mod.role.toLowerCase().includes(query.toLowerCase())
  );

  if (filtered.length === 0) {
    results.textContent = "No moderators found.";
    return;
  }

  filtered.forEach(mod => {
    const card = document.createElement("div");
    card.className = "card";

    const name = document.createElement("h3");
    name.textContent = mod.name;

    const role = document.createElement("p");
    role.textContent = "Role: " + mod.role;

    card.append(name, role);
    results.appendChild(card);
  });
}

search.addEventListener("input", () => {
  displayModerators(search.value);
});

displayModerators();
</script>

</body>
</html>
