<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Modly | Yeeps Moderator Searcher</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  color: #fff8ec;
  background:
    radial-gradient(ellipse at 10% 15%, #397b62 0 2%, transparent 3%),
    radial-gradient(ellipse at 90% 25%, #397b62 0 3%, transparent 4%),
    radial-gradient(ellipse at 15% 85%, #397b62 0 4%, transparent 5%),
    linear-gradient(140deg, #082f2b, #155b4d);
}

.flowers {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  opacity: .45;
  z-index: -1;
}

.flower {
  position: absolute;
  color: #ffb8ae;
  font-size: 65px;
}

.flower:nth-child(1) { top: 5%; left: 5%; }
.flower:nth-child(2) { top: 25%; right: 7%; color: #fff0d5; }
.flower:nth-child(3) { bottom: 12%; left: 10%; }
.flower:nth-child(4) { bottom: 30%; right: 12%; color: #fff0d5; }
.flower:nth-child(5) { top: 60%; left: 45%; font-size: 35px; }

header {
  text-align: center;
  padding: 75px 20px 25px;
}

.logo {
  font-size: clamp(60px, 12vw, 105px);
  font-weight: 900;
  letter-spacing: 5px;
  color: #ffb5aa;
  text-shadow: 4px 5px 0 #754944;
}

.subtitle {
  font-size: 18px;
  margin-top: 8px;
  color: #fff0dc;
}

.description {
  max-width: 550px;
  margin: 22px auto;
  line-height: 1.7;
  color: #e0eee4;
}

.search-container {
  max-width: 680px;
  padding: 0 20px;
  margin: 35px auto;
}

#search {
  width: 100%;
  padding: 20px 25px;
  border: 2px solid #ffb5aa;
  border-radius: 50px;
  outline: none;
  font-size: 16px;
  background: #fff8ec;
  color: #174d42;
  box-shadow: 0 8px 25px #0003;
}

#search:focus {
  border-color: white;
}

.results {
  max-width: 750px;
  padding: 0 20px 60px;
  margin: auto;
}

.result {
  background: #174d42;
  border: 1px solid #548875;
  border-radius: 17px;
  padding: 20px;
  margin-bottom: 14px;
  box-shadow: 0 5px 18px #0002;
}

.result h3 {
  color: #ffb5aa;
  margin: 0 0 8px;
}

.result p {
  color: #e4eee5;
  margin: 0;
}

.empty {
  text-align: center;
  padding: 30px;
  color: #ffb5aa;
}

footer {
  text-align: center;
  padding: 25px;
  color: #d4e5d9;
  font-size: 13px;
}
</style>
</head>

<body>

<div class="flowers">
  <span class="flower">✿</span>
  <span class="flower">❀</span>
  <span class="flower">✿</span>
  <span class="flower">❀</span>
  <span class="flower">✿</span>
</div>

<header>
  <div class="logo">Modly</div>

  <div class="subtitle">
    ✿ Yeeps Moderator Searcher ✿
  </div>

  <p class="description">
    A tool designed to help Yeeps moderators quickly find
    relevant information and keep moderation organized.
    Simple, fast, and easy to use.
  </p>
</header>

<div class="search-container">
  <input
    id="search"
    type="text"
    placeholder="Search moderators by username or role..."
    autocomplete="off"
  >
</div>

<main class="results" id="results"></main>

<footer>
  Modly · Yeeps Moderator Searcher
</footer>

<script>
const moderators = [
  { name: "ExampleMod1", role: "Senior Moderator" },
  { name: "ExampleMod2", role: "Moderator" },
  { name: "ExampleMod3", role: "Junior Moderator" },
  { name: "ExampleMod4", role: "Support" }
];

const search = document.getElementById("search");
const results = document.getElementById("results");

function displayModerators(query = "") {
  results.innerHTML = "";

  const filtered = moderators.filter(mod =>
    mod.name.toLowerCase().includes(query.toLowerCase()) ||
    mod.role.toLowerCase().includes(query.toLowerCase())
  );

  if (filtered.length === 0) {
    results.innerHTML =
      '<div class="empty">No moderators found ✿</div>';
    return;
  }

  filtered.forEach(mod => {
    const card = document.createElement("div");
    card.className = "result";

    const name = document.createElement("h3");
    name.textContent = mod.name;

    const role = document.createElement("p");
    role.textContent = "Role: " + mod.role;

    card.append(name, role);
    results.appendChild(card);
  });
}

search.addEventListener("input", () => {
  displayModerators(search.value);
});

displayModerators();
</script>

</body>
</html>
